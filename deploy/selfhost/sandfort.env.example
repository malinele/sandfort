# Sandfort self-host settings. Copy this file to sandfort.env (same directory) and fill in the
# secrets. Do not edit the example: it stays as shipped, so the bundle signature still matches.
# compose.yml sets SANDFORT_ENVIRONMENT, the database URL and the seccomp path itself.
# Every secret below is empty on purpose. The server refuses to start in prod without the
# ones marked REQUIRED. Names come from docs/operations.md and src/sandfort/config.py.

# --- secrets -------------------------------------------------------------------------------
# REQUIRED. Salts the API key hashes. Keep it stable: changing it invalidates every API key.
# Generate: openssl rand -hex 32
SANDFORT_API_KEY_PEPPER=

# REQUIRED in prod. A Fernet key that seals webhook secrets at rest.
# Generate: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# (or run the same one-liner inside the api container after the first build).
SANDFORT_WEBHOOK_SECRET_KEY=

# Strongly advised. Keys the audit hash chain (at least 32 bytes). Without it prod starts with
# a warning and an unkeyed chain. Keep it stable. Generate: openssl rand -hex 32
SANDFORT_AUDIT_CHAIN_KEY=

# Optional. Signs user session tokens (at least 32 characters). Empty turns user sessions off.
# SANDFORT_SESSION_SECRET=

# --- node capacity (REQUIRED) ---------------------------------------------------------------
# Total CPU and memory the host admits across all sandboxes. The server refuses to start in prod
# with either at zero. The values below suit an 8 vCPU / 16 GiB host. Use your own figures and
# leave headroom for the OS, Docker and this stack.
SANDFORT_HOST_CAPACITY_CPU_MILLICORES=6000
SANDFORT_HOST_CAPACITY_MEMORY_MIB=12288
SANDFORT_NODE_MAX_SANDBOXES=20
SANDFORT_MAX_SANDBOX_CPU_MILLICORES=2000
SANDFORT_MAX_SANDBOX_MEMORY_MIB=4096
SANDFORT_MAX_SANDBOX_DISK_GIB=10

# --- isolation tiers ------------------------------------------------------------------------
# Tier to Docker runtime. gvisor needs runsc registered (deploy/node-setup.sh does that).
# Add microvm=kata only after node-setup.sh --with-kata on a host with /dev/kvm.
# A container=runc tier trips the "root on runc" gate unless user namespaces are remapped, so it
# is left out here.
SANDFORT_ISOLATION_RUNTIMES=gvisor=runsc
# SANDFORT_ISOLATION_RUNTIMES=gvisor=runsc,microvm=kata
SANDFORT_DEFAULT_ISOLATION=gvisor
# Public resolvers written into gVisor sandboxes. Change them to use an internal resolver.
SANDFORT_GVISOR_DNS=1.1.1.1,8.8.8.8
# Disk quota needs overlay2 on XFS with pquota. Prod enforces it anyway.
SANDFORT_ENFORCE_DISK_QUOTA=true
# Tenant image builds run on the daemon default runtime. Run node-setup.sh with
# --default-runtime-runsc so that it is runsc. Only set this to false knowingly.
# SANDFORT_REQUIRE_BUILD_RUNTIME=false

# --- network and egress ---------------------------------------------------------------------
# Run deploy/host-setup.sh as root now and on every boot. In prod the egress probe checks the
# rules at start (it needs the alpine:3.20 image, pulled on first use). Do not set
# SANDFORT_EGRESS_ACKNOWLEDGED=true unless you know the rules are missing and accept that.
SANDFORT_WEBHOOK_REQUIRE_HTTPS=true
SANDFORT_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Uncomment to give every create that names no network policy block_all.
# SANDFORT_DEFAULT_BLOCK_NETWORK=true

# --- operations -----------------------------------------------------------------------------
SANDFORT_LOG_LEVEL=INFO
# The commit this build came from (RELEASE.txt names it). Shown as build_sha in GET /v1/status.
# SANDFORT_BUILD_SHA=
# Optional operator notice. Needs the notice volume in compose.yml (see the comment there).
# SANDFORT_STATUS_NOTICE_FILE=/etc/sandfort/notice/notice.txt
# uvicorn trusts X-Forwarded-* only from these addresses (your TLS proxy).
# SANDFORT_FORWARDED_ALLOW_IPS=127.0.0.1
