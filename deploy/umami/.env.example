# Copy to .env and replace every CHANGE_ME value. Never commit the real .env (the repo
# .gitignore already ignores `.env`).
#
# Generate secrets with:
#   openssl rand -hex 32    # APP_SECRET
#   openssl rand -hex 24    # POSTGRES_PASSWORD (hex only: the password is embedded in
#                           # DATABASE_URL, so it must not contain '@', ':' or '/')

POSTGRES_DB=umami
POSTGRES_USER=umami
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

APP_SECRET=CHANGE_ME_openssl_rand_hex_32

# Host address and port the reverse proxy forwards to. Keep 127.0.0.1 when the proxy runs on
# the same host; use another address only for a proxy in a cluster (README.md section 8,
# option B) and never a public one.
UMAMI_BIND=127.0.0.1
UMAMI_PORT=3000
